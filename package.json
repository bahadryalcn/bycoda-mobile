{
  "name": "bycoda-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.8.2",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:ui": "node scripts/check-ui.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:release": "node scripts/check-store-config.mjs",
    "typecheck": "node scripts/build-ui-theme.mjs --check && node scripts/check-ui.mjs && node scripts/check-runtime.mjs && node scripts/check-locales.mjs && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "export:web": "expo export --platform web --output-dir ../temp/build/bycoda-mobile-web",
    "theme:build": "node scripts/build-ui-theme.mjs",
    "theme:check": "node scripts/build-ui-theme.mjs --check",
    "prestart": "pnpm theme:build",
    "preandroid": "pnpm theme:build",
    "preios": "pnpm theme:build",
    "preweb": "pnpm theme:build",
    "preexport:web": "pnpm theme:build"
  },
  "dependencies": {
    "@expo/html-elements": "57.0.0",
    "@gluestack-ui/core": "5.0.15",
    "@gluestack-ui/utils": "5.0.6",
    "@gorhom/bottom-sheet": "5.2.14",
    "@legendapp/list": "3.6.0",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.104.1",
    "ai": "7.0.138",
    "diff": "9.0.0",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-glass-effect": "57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "57.0.20",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "1.55.0",
    "markdown-it": "15.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "uniwind": "1.12.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.0",
    "esbuild": "0.28.2",
