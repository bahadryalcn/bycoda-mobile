{
  "expo": {
    "name": "bycoda",
    "slug": "bycoda-mobile",
    "scheme": "bycoda",
    "version": "0.1.0",
    "icon": "../public/brand/bycoda/mobile-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bycoda.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
        "NSLocalNetworkUsageDescription": "Connect to your Bycoda computer on your private network."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.bycoda.mobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "../public/brand/bycoda/mobile-adaptive-foreground.png",
        "monochromeImage": "../public/brand/bycoda/mobile-adaptive-foreground.png",
        "backgroundColor": "#000000"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "../public/brand/bycoda/favicon-32.png"
    },
    "plugins": [
      "./scripts/with-local-network.cjs",
      "expo-router",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "light"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["tr", "en", "de", "fr", "es", "pt", "zh-CN", "ja"]
        }
      ],
      "expo-secure-store",
      ["expo-notifications", { "defaultChannel": "bycoda" }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to attach to your Bycoda messages.",
          "cameraPermission": "Allow Bycoda to scan the pairing QR code on your computer.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to securely access your Bycoda computers."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bycoda to scan the pairing QR code on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "../public/brand/bycoda/mark-white.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "engagement": {
        "iosAppStoreUrl": null,
        "androidPlayStoreUrl": null,
        "publicAppUrl": "https://github.com/bahadryalcn/bycoda"
      }
    }
  }
}
