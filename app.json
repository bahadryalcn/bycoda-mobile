{
  "expo": {
    "name": "bycoda",
    "slug": "bycoda-mobile",
    "scheme": "bycoda",
    "version": "0.1.0",
    "icon": "./assets/brand/mobile-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:link.bycoda.codes"
      ],
      "bundleIdentifier": "com.bycoda.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Connect to your Bycoda computer on your private network.",
        "NSMicrophoneUsageDescription": "Speak to your Bycoda assistant. Audio is processed on your connected computer."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.bycoda.mobile",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "link.bycoda.codes",
              "pathPrefix": "/session/v1/"
            },
            {
              "scheme": "https",
              "host": "link.bycoda.codes",
              "pathPrefix": "/new/v1"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/mobile-adaptive-foreground.png",
        "monochromeImage": "./assets/brand/mobile-adaptive-foreground.png",
        "backgroundColor": "#000000"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2b86d28c-1c30-4ca7-966d-bba4a8da19df"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "../public/brand/bycoda/favicon-32.png"
    },
    "plugins": [
      "./scripts/with-local-network.cjs",
      "expo-router",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "light"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "tr",
            "en",
            "de",
            "fr",
            "es",
            "pt",
            "zh-CN",
            "ja"
          ]
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-notifications",
        {
          "defaultChannel": "bycoda",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to attach to your Bycoda messages.",
          "cameraPermission": "Allow Bycoda to scan the pairing QR code on your computer.",
          "microphonePermission": "Speak to your Bycoda assistant. Audio is processed on your connected computer."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to securely access your Bycoda computers."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bycoda to scan the pairing QR code on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "../public/brand/bycoda/mark-white.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.bycoda.mobile.widgets",
          "groupIdentifier": "group.com.bycoda.mobile",
          "enablePushNotifications": false,
          "frequentUpdates": true,
          "enableAndroid": true,
          "widgets": [
            {
              "name": "ActiveSessions",
              "displayName": "Active sessions",
              "description": "Running and waiting agent sessions.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular"
                ]
              },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/features/widgets/ui/ActiveSessions.android.tsx"
              }
            },
            {
              "name": "NeedsAttention",
              "displayName": "Needs attention",
              "description": "Sessions waiting for you or failed.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/features/widgets/ui/NeedsAttention.android.tsx"
              }
            },
            {
              "name": "UsageLimits",
              "displayName": "Usage limits",
              "description": "Codex and Claude session and weekly limit usage.",
              "ios": { "supportedFamilies": ["systemSmall", "systemMedium", "accessoryRectangular"] },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/features/widgets/ui/UsageLimits.android.tsx"
              }
            },
            {
              "name": "SessionActivity",
              "displayName": "Session activity",
              "description": "Live status of running sessions.",
              "android": null,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_icon": {
              "foregroundImage": "./assets/brand/mobile-adaptive-foreground.png",
              "backgroundColor": "#000000"
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-dontwarn kotlin.MustUseReturnValues\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save images to your photos",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Speak to your Bycoda assistant. Audio is processed on your connected computer.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.com.bycoda.mobile",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 7,
            "NSExtensionActivationSupportsMovieWithMaxCount": 1,
            "NSExtensionActivationSupportsFileWithMaxCount": 7
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "application/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ]
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "reporting": {
        "provider": "firebase",
        "endpoint": null
      },
      "engagement": {
        "iosAppStoreUrl": null,
        "androidPlayStoreUrl": null,
        "publicAppUrl": "https://github.com/bahadryalcn/bycoda"
      },
      "eas": {
        "projectId": "2b86d28c-1c30-4ca7-966d-bba4a8da19df"
      }
    },
    "owner": "bahadryalcn"
  }
}
