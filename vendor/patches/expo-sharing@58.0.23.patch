-class SharingFileProvider : FileProvider()
+class SharingFileProvider : FileProvider() {
+  override fun getType(uri: Uri): String? {
+    // Let FileProvider resolve and validate the file within its configured roots.
+    val detectedType = super.getType(uri)
+    val offeredType = uri.getQueryParameter(MIME_TYPE_QUERY_PARAMETER)
+    return offeredType?.takeIf { MIME_TYPE.matches(it) } ?: detectedType
+  }
+
+  companion object {
+    const val MIME_TYPE_QUERY_PARAMETER = "expoSharingMimeType"
+    private val MIME_TYPE = Regex("[a-z0-9!#$&^_.+%-]+/[a-z0-9!#$&^_.+%-]+")
+  }
+}
