+  // Inexact, non-waking alarm: stale feedback redraws without JS; Android may defer it in Doze.
+  private fun scheduleExpiry(props: Map<String, Any?>) {
+    val manager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+    val ids = AppWidgetManager.getInstance(context).getAppWidgetIds(widgetProviderComponentName(context, name))
+    val intent = Intent(AppWidgetManager.ACTION_APPWIDGET_UPDATE)
+      .setComponent(widgetProviderComponentName(context, name))
+      .putExtra(AppWidgetManager.EXTRA_APPWIDGET_IDS, ids)
+    val pending = PendingIntent.getBroadcast(context, name.hashCode(), intent,
+      PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+    manager.cancel(pending)
+    val expiresAt = props["expiresAt"] as? Number ?: return
+    if (props["state"] != "ready" || ids.isEmpty()) return
+    val delay = maxOf(1000L, expiresAt.toLong() - System.currentTimeMillis())
+    manager.set(AlarmManager.ELAPSED_REALTIME, SystemClock.elapsedRealtime() + delay, pending)
   }
